<style>
.cards-image-section {
  margin: 0 auto;
  max-width: 1500px;
  padding: 0 20px;
}
.cards-image-section h2 {
  color: #ffd34d;
  text-align: center;
  letter-spacing: 3px;
  margin-bottom: 18px;
}
.cards-image-section img {
  width: 100%;
  border: 1px solid #0e8da5;
  border-radius: 14px;
  box-shadow: 0 0 28px rgba(0,220,255,0.22);
}

.cardiac-bg{
background:
linear-gradient(rgba(2,10,18,.35),rgba(2,10,18,.45)),
url("../assets/cards/cardiac_card_bg.png");
background-size:100%;
background-position:center;
background-repeat:no-repeat;
}



.future-card{
display:flex;
flex-direction:column;
justify-content:center;
align-items:center;
min-height:330px;
border:1px dashed rgba(0,220,255,.35);
background:rgba(2,10,18,.55);
}

.future-dots{
display:flex;
gap:18px;
margin-bottom:28px;
}

.future-dots span{
width:14px;
height:14px;
border-radius:50%;
background:#17d8ff;
box-shadow:0 0 18px #17d8ff;
animation:pulseDots 1.8s infinite ease-in-out;
}

.future-dots span:nth-child(2){
animation-delay:.3s;
}

.future-dots span:nth-child(3){
animation-delay:.6s;
}

@keyframes pulseDots{
0%,100%{opacity:.35;transform:scale(.9);}
50%{opacity:1;transform:scale(1.15);}
}



.robotics-bg{
position:relative;
overflow:hidden;
}

.robotics-bg::after{
content:"";
position:absolute;
left:58%;
top:62%;
width:26px;
height:26px;
border-radius:50%;
background:radial-gradient(circle, rgba(255,255,255,.95) 0%, rgba(0,220,255,.85) 22%, rgba(0,220,255,.25) 48%, rgba(0,220,255,0) 72%);
box-shadow:0 0 18px rgba(0,220,255,.9),0 0 42px rgba(0,220,255,.45);
opacity:0;
pointer-events:none;
animation:weldingFlash 2s infinite;
}

@keyframes weldingFlash{
0%,72%,100%{opacity:0;transform:scale(.4);}
76%{opacity:1;transform:scale(1.15);}
80%{opacity:.25;transform:scale(.75);}
84%{opacity:.9;transform:scale(1);}
88%{opacity:0;transform:scale(.45);}
}

</style>

