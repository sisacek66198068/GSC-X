.cards-image-section h2 {
  color: #ffd34d;
  text-align: center;
  letter-spacing: 3px;
  margin-bottom: 18px;
}
.cards-image-section img {
  width: 100%;
  border: 1px solid #0e8da5;
  border-radius: 14px;
  box-shadow: 0 0 28px rgba(0,220,255,0.22);
}

.cards-image-section{
  position:relative;
}

.cards-image-section::after{
  content:"";
  position:absolute;
  left:40.5%;
  top:36.5%;
  width:28px;
  height:28px;
  border-radius:50%;
  background:radial-gradient(circle, rgba(255,255,255,1) 0%, rgba(0,220,255,.95) 20%, rgba(0,220,255,.35) 48%, rgba(0,220,255,0) 75%);
  box-shadow:0 0 20px rgba(0,220,255,.95),0 0 50px rgba(0,220,255,.55);
  opacity:0;
  pointer-events:none;
  animation:homeWeldFlash 2s infinite;
}

@keyframes homeWeldFlash{
  0%,72%,100%{opacity:0;transform:scale(.35);}
  75%{opacity:1;transform:scale(1.25);}
  79%{opacity:.25;transform:scale(.75);}
  83%{opacity:1;transform:scale(1);}
  88%{opacity:0;transform:scale(.4);}
}

